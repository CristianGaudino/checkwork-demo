# Names only. Copy to .env.local for local work and never commit real values. Worker secrets go in the Cloudflare dashboard
# (Workers, Settings, Variables and secrets); NEXT_PUBLIC_ ones are inlined at build, so they go in deploy.yml's env.

# ---- What kind of site this is ----
# "production" for a real dealer: indexed, real emails, no simulated services, no demo records. Leave unset (or "demo") for a demo.
APP_ENV=
# "off" on a real dealer's site: no demo bar (Customer / Dealer switch, theme toggle, Margins and DoneDeal switches).
NEXT_PUBLIC_DEMO_BAR=
# The made-up leads, reviews, posts and team in the dashboard. On by default except on a production site. "on" for a production
# showcase, "off" for a demo that should start empty.
DEMO_RECORDS=
# Posts, ads, newsletters and the registration lookup act as if connected when they have no keys. On by default except on a
# production site; "off" shows "not connected" instead.
SIMULATE_INTEGRATIONS=

# ---- Stock ----
# "checkwork" (the dealer adds and edits cars in the dashboard) or "donedeal" (synced from DoneDeal, read only in the dashboard).
NEXT_PUBLIC_STOCK_SOURCE=
# The dealer's page on DoneDeal, for the "Open DoneDeal" buttons.
NEXT_PUBLIC_DONEDEAL_DEALER_URL=
# DoneDeal's API key for this dealer's own site (a secret; DoneDeal issues it with the dealer's written consent). Without it the sync says
# "not connected" (simulated on the demo, where the feed is the stock itself).
DONEDEAL_API_KEY=
# A long random secret the Worker's scheduled jobs send to the app (wrangler secret put CRON_KEY): the 15-minute DoneDeal sync and the
# morning follow-up emails. Without it neither runs on a schedule; Sync now in the dashboard still works.
CRON_KEY=

# ---- Leads ----
# Where lead emails go. A Worker secret. Set it before TURNSTILE_SECRET_KEY: with no address, leads are refused rather than saved unseen.
# The dealer can also set the addresses in the dashboard (Settings, Lead emails), which win over this.
LEAD_TO_EMAIL=
# Turnstile server key that checks the bot token. A Worker secret.
TURNSTILE_SECRET_KEY=
# Turnstile site key. Public, inlined at build (deploy.yml env).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Signs the trade-in photo links in the dealer email (HMAC, 7 days). A Worker secret: 32 random bytes, never committed.
PHOTO_LINK_SECRET=

# ---- Dealer dashboard (/dashboard) ----
# Cloudflare Access: the Worker checks the signed token itself. The team domain (name.cloudflareaccess.com) and the application's AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Shows the Dashboard link and the dealer views when Access protects the site (deploy.yml env).
NEXT_PUBLIC_ACCESS_ENABLED=
# Signed-in addresses that are always owners, comma separated: the first owner, who then adds the team (and their roles) in Settings.
# Everyone else Access lets in gets the role their email has on the team, or no permissions at all.
ADMIN_OWNER_EMAILS=
# CI only: opens the dashboard with no Access token so the E2E suite can test it. Never on a deployed site.
NEXT_PUBLIC_ADMIN_OPEN=

# ---- Outside services (each is optional; the dashboard's Settings lists what is still missing) ----
# Google reviews (Places API New). Both unset means the demo reviews.
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
# Replies to Google reviews from the dashboard (Google Business Profile API, the dealer's verified profile): the location
# ("accounts/<id>/locations/<id>") and an OAuth refresh token from its owner or a manager. Unset: replies simulated on a demo.
GOOGLE_BUSINESS_LOCATION=
GOOGLE_BUSINESS_REFRESH_TOKEN=
# Registration lookup (Cartell). Unset: the plate's own year and county only (simulated on a demo).
CARTELL_API_KEY=
# Facebook and Instagram posting.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ID=
# Ads (Meta and Google).
META_AD_ACCOUNT_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Newsletters and stock alerts.
NEWSLETTER_API_KEY=
NEWSLETTER_FROM_EMAIL=
# Signs the unsubscribe link in each newsletter and stock alert email (HMAC, a year). A Worker secret: 32 random bytes, never committed.
UNSUBSCRIBE_SECRET=
# Real visitor numbers in Analytics.
CF_ANALYTICS_TOKEN=
CF_ZONE_ID=
