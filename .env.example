# Names only. Copy to .env.local for local work and never commit real values. Worker secrets go in the Cloudflare dashboard
# (Workers, Settings, Variables and secrets); NEXT_PUBLIC_ ones are inlined at build, so they go in deploy.yml's env.

# ---- What kind of site this is ----
# "production" for a real dealer: indexed, real emails, no simulated registration lookup. Leave unset (or "demo") for a demo.
APP_ENV=
# The registration lookup answers with a sample car when it has no key. On by default except on a production site; "on" or "off" overrides it.
SIMULATE_INTEGRATIONS=

# ---- Stock ----
# "donedeal" takes the factory-order pages out (that dealer's stock is synced from a listing site and has no orders here). Anything else: "checkwork".
NEXT_PUBLIC_STOCK_SOURCE=

# ---- Leads ----
# Where lead emails go. A Worker secret. Set it before TURNSTILE_SECRET_KEY: with no address, leads are refused rather than saved unseen.
LEAD_TO_EMAIL=
# Turnstile server key that checks the bot token. A Worker secret.
TURNSTILE_SECRET_KEY=
# Turnstile site key. Public, inlined at build (deploy.yml env).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Signs the trade-in photo links in the dealer email (HMAC, 7 days). A Worker secret: 32 random bytes, never committed.
PHOTO_LINK_SECRET=

# ---- Dealer dashboard (checkwork-dash, docs/dealer-admin.md) ----
# Each stored lead is also sent to the dealer dashboard's site API. DASH_SITE_KEY is the site key made in the dashboard (a Worker secret);
# unset, nothing is sent. The DASH service binding (wrangler.jsonc) is used when present; else a normal fetch to DASH_URL.
DASH_URL=
DASH_SITE_KEY=

# ---- Outside services (each is optional) ----
# Google reviews (Places API New). Both unset means the demo reviews. GOOGLE_PLACE_ID also makes the directions link.
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
# Registration lookup (Cartell). Unset: the plate's own year and county only (a sample car on a demo).
CARTELL_API_KEY=
