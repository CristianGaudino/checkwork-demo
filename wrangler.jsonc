{
	// The Checkwork demo website (the Showroom): its own Worker, domain, D1 database and R2 bucket. The names below are created in the Cloudflare dashboard or with wrangler (docs/new-site-checklist.md).
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "checkwork-demo",
	"main": "worker.mjs", // wraps .open-next/worker.js and adds the daily purge
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
	// DASH: the dealer dashboard's production Worker (checkwork-dash, src/lib/leads/dash.ts), Worker to Worker, past Cloudflare Access on
	// its host. Leads go there only once the DASH_SITE_KEY secret is set; without it nothing is sent.
	"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "checkwork-demo" }, { "binding": "DASH", "service": "checkwork-dash" }],
	// The bare domain is a second custom domain: worker.mjs redirects it to www.
	"routes": [{ "pattern": "www.demo.checkwork.ie", "custom_domain": true }, { "pattern": "demo.checkwork.ie", "custom_domain": true }],
	"workers_dev": false,
	// worker.mjs: daily at 03:17 UTC, deletes old leads and their photos, and old counts.
	"triggers": { "crons": ["17 3 * * *"] },
	"observability": { "enabled": true },
	// Lead emails to the dealer (D-01). No "remote": CI's wrangler dev has no Cloudflare credentials, so it uses the local simulator.
	"send_email": [{ "name": "EMAIL" }],
	// Per-IP limit on lead submits (D-05), a second layer behind Turnstile: 5 per minute.
	"ratelimits": [{ "name": "LEAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }, { "name": "COUNT_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }, { "name": "DRIVE_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }],
	// Trade-in photos (D-13): private, EU jurisdiction, read only through the signed /lead-photos route. wrangler dev uses a local bucket.
	"r2_buckets": [{ "binding": "LEAD_PHOTOS", "bucket_name": "checkwork-demo-lead-photos", "jurisdiction": "eu" }],
	// Leads (D-03): Cloudflare D1. Create it once with `npx wrangler d1 create checkwork-demo --jurisdiction eu` and paste the id below
	// (an id is not a secret). migrations_dir is where drizzle-kit writes the SQL; npm run db:migrate applies it.
	"d1_databases": [{ "binding": "DB", "database_name": "checkwork-demo", "database_id": "34be3b71-c449-4676-802f-04999ab61a73", "migrations_dir": "drizzle" }]
}
